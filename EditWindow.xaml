<Window x:Class="Kontaktverwaltung.EditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kontaktverwaltung"
        mc:Ignorable="d"
        Title="EditWindow" Height="450" Width="679">
    <Grid>
        <TextBox x:Name="Tbx_Name" MaxLength="40" HorizontalAlignment="Center" Height="43" Margin="0,88,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="366" TextAlignment="Center" VerticalContentAlignment="Center"/>
        <TextBlock Text="Name" Foreground="Gray" IsHitTestVisible="False"
                   HorizontalAlignment="Center" VerticalAlignment="Top"
                   Margin="0,88,0,0" Width="366" Height="43" Padding="13"
                   TextAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Text, ElementName=Tbx_Name}" Value="">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <TextBox x:Name="Tbx_Telefon" MaxLength="20" HorizontalAlignment="Center" Height="43" Margin="0,174,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="366" TextAlignment="Center" VerticalContentAlignment="Center"/>
        <TextBlock Text="Telefonnummer" Foreground="Gray" IsHitTestVisible="False" HorizontalAlignment="Center" Height="43" Margin="0,174,0,0" VerticalAlignment="Top" Width="366" TextAlignment="Center" Padding="13">
        <TextBlock.Style>
            <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Text, ElementName=Tbx_Telefon}" Value="">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </TextBlock.Style>
        </TextBlock>
        <Label x:Name="Lbl_Titel" Content="Neuer Kontakt" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Height="35" Margin="0,29,0,0" VerticalAlignment="Top" Width="300" FontSize="16" FontWeight="Bold" Padding="0,0,0,0"/>
        <Button x:Name="Btn_Ok" Content="Speichern" HorizontalAlignment="Center" VerticalAlignment="Top" Width="150" Height="35" Margin="0,260,0,0" Click="Btn_Ok_Click"></Button>
    </Grid>
</Window>
